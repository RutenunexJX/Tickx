{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroslack.local/schemas/stimulus/v3/stimulus-scenario.schema.json",
  "title": "ZeroSlack Stimulus Scenario v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestSchemaVersion",
    "identity",
    "manifestIdentity",
    "workspaceId",
    "target",
    "scenario"
  ],
  "properties": {
    "schemaVersion": {"const": 3},
    "manifestSchemaVersion": {"enum": [1, 2, 3]},
    "identity": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/sha256"},
    "manifestIdentity": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/sha256"},
    "workspaceId": {"type": "string", "minLength": 1},
    "target": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/target"},
    "scenario": {"$ref": "#/$defs/scenario"}
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "timeBasePicosecondsPerTick",
        "durationTicks",
        "groups",
        "ports",
        "markers",
        "view"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "timeBasePicosecondsPerTick": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/positiveTick"},
        "durationTicks": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/positiveTick"},
        "groups": {
          "type": "array",
          "items": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/group"}
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/port"}
        },
        "markers": {
          "type": "array",
          "items": {"$ref": "../v2/stimulus-scenario.schema.json#/$defs/marker"}
        },
        "view": {"$ref": "../v2/stimulus-scenario.schema.json#/$defs/view"}
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "sourceIndex", "storageIndex"],
      "properties": {
        "kind": {"enum": ["struct-member", "packed-index", "unpacked-index", "interface-member"]},
        "name": {"type": "string"},
        "sourceIndex": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "storageIndex": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "rootPortName",
        "relativePath",
        "selectors",
        "structured",
        "packedBitOffsetValid",
        "packedBitOffset",
        "interfaceName",
        "modportName",
        "direction",
        "canonicalTypeId",
        "declarationShapeId",
        "width",
        "signed",
        "sourceOrder"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "rootPortName": {"type": "string", "minLength": 1},
        "relativePath": {"type": "string"},
        "selectors": {"type": "array", "items": {"$ref": "#/$defs/selector"}},
        "structured": {"type": "boolean"},
        "packedBitOffsetValid": {"type": "boolean"},
        "packedBitOffset": {"type": "integer", "minimum": 0},
        "interfaceName": {"type": "string"},
        "modportName": {"type": "string"},
        "direction": {"enum": ["input", "output", "inout", "ref"]},
        "canonicalTypeId": {"type": "string"},
        "declarationShapeId": {"type": "string"},
        "width": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "signed": {"type": "boolean"},
        "sourceOrder": {"type": "integer", "minimum": 0}
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "laneId",
        "displayOrder",
        "role",
        "kind",
        "radix",
        "visible",
        "groupId",
        "binding",
        "enumMap",
        "segments",
        "clock",
        "reset"
      ],
      "properties": {
        "laneId": {"type": "string", "minLength": 1},
        "displayOrder": {"type": "integer", "minimum": 0},
        "role": {"enum": ["stimulus", "watch", "stimulus-watch"]},
        "kind": {"enum": ["clock", "bit", "bus", "enum"]},
        "radix": {"enum": ["binary", "octal", "decimal", "hexadecimal"]},
        "visible": {"type": "boolean"},
        "groupId": {"type": "string"},
        "binding": {"$ref": "#/$defs/binding"},
        "enumMap": {"type": "object", "additionalProperties": {"type": "string"}},
        "segments": {"type": "array", "items": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/range"}},
        "clock": {"oneOf": [{"type": "null"}, {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/clock"}]},
        "reset": {"oneOf": [{"type": "null"}, {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/reset"}]}
      }
    }
  }
}
