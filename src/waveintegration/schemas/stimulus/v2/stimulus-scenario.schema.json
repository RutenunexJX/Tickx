{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroslack.local/schemas/stimulus/v2/stimulus-scenario.schema.json",
  "title": "ZeroSlack Stimulus Scenario v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestSchemaVersion",
    "identity",
    "manifestIdentity",
    "workspaceId",
    "target",
    "scenario"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "manifestSchemaVersion": {"enum": [1, 2]},
    "identity": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/sha256"},
    "manifestIdentity": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/sha256"},
    "workspaceId": {"type": "string", "minLength": 1},
    "target": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/target"},
    "scenario": {"$ref": "#/$defs/scenario"}
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "timeBasePicosecondsPerTick",
        "durationTicks",
        "groups",
        "ports",
        "markers",
        "view"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "timeBasePicosecondsPerTick": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/positiveTick"},
        "durationTicks": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/positiveTick"},
        "groups": {
          "type": "array",
          "items": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/group"}
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/port"}
        },
        "markers": {
          "type": "array",
          "items": {"$ref": "#/$defs/marker"}
        },
        "view": {"$ref": "#/$defs/view"}
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startTick", "endTick", "kind", "note"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "startTick": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/tick"},
        "endTick": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/tick"},
        "kind": {"enum": ["point", "region"]},
        "note": {"type": "string"}
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedPortName", "cursorTick", "visibleSpanTicks"],
      "properties": {
        "selectedPortName": {"type": "string"},
        "cursorTick": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/tick"},
        "visibleSpanTicks": {"$ref": "../v1/stimulus-scenario.schema.json#/$defs/tick"}
      }
    }
  }
}
