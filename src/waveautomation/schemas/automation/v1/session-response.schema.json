{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-response.schema.json",
  "title": "Tickx GUI session CLI response v1",
  "type": "object",
  "required": [
    "schema",
    "command",
    "ok"
  ],
  "properties": {
    "schema": {
      "const": "wave-workbench.session/v1"
    },
    "command": {
      "type": "string",
      "pattern": "^session\\."
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "adoptionPending": {
      "const": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      },
      "else": {
        "required": [
          "error"
        ]
      }
    }
  ]
}
